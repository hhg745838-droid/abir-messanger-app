rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profile cards for search/chat display
      allow read: if isSignedIn();

      // Only owner can create their user document
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30;

      // Only owner can update their user document
      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && request.resource.data.uid == userId;

      allow delete: if false;
    }

    // Username reservation registry
    match /usernames/{username} {
      allow read: if isSignedIn();
      
      // Can only claim username if document doesn't exist and matches authenticated user's uid
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 3
        && username.size() <= 30;

      // Can update only by owner
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Must be participant to read conversation
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Can create if authenticated user is one of the participants
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Can update if user is participant (e.g., updating lastMessage, unreadCount, typing state)
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        // Only participants can send messages and senderId must match auth.uid
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        // Participants can update status (e.g., marking read)
        allow update: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Calls collection for WebRTC signaling
    match /calls/{callId} {
      // Only caller or receiver can read or write call document
      allow read: if isSignedIn() && (
        resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );

      // ICE candidates subcollections
      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid
        );
      }

      match /receiverCandidates/{candidateId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid
        );
      }
    }
  }
}
